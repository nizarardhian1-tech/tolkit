<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Theme -->
    <style name="Theme.App.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Main Theme -->
    <style name="Theme.DNS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>

        <!-- Typography -->
        <item name="fontFamily">@font/font_inter_regular</item>
        <item name="android:fontFamily">@font/font_inter_regular</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.Headline</item>

        <!-- Corner Shapes -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.Corner.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Corner.ExtraLarge</item>

        <!-- Component Overrides -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView.Glass</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.Fab</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
        <item name="navigationViewStyle">@style/Widget.App.NavigationView</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
    </style>

    <!-- Shape Styles -->
    <style name="ShapeAppearance.App.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.App.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">32dp</item>
    </style>

    <!-- Glass Card -->
    <style name="Widget.App.CardView.Glass" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_surface_container</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/stroke_glass</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="rippleColor">@color/glass_highlight</item>
        <item name="android:outlineAmbientShadowColor">@color/card_shadow_color</item>
        <item name="android:outlineSpotShadowColor">@color/card_shadow_color</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">@font/font_inter_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">@font/font_inter_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/glass_stroke</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/font_inter_regular</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/font_inter_regular</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/font_inter_semibold</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/font_inter_semibold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/font_inter_semibold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Navigation Drawer -->
    <style name="Widget.App.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemShapeAppearance">@style/ShapeAppearance.App.DrawerItem</item>
        <item name="itemShapeInsetStart">16dp</item>
        <item name="itemShapeInsetEnd">16dp</item>
        <item name="itemHorizontalPadding">18dp</item>
        <item name="itemIconPadding">20dp</item>
        <item name="itemTextAppearance">@style/NavDrawerTextStyle</item>
        <item name="subheaderTextAppearance">@style/TextAppearance.App.NavSubheader</item>
        <item name="divider">@drawable/nav_divider_elegant</item>
        <item name="dividerInsetStart">28dp</item>
        <item name="dividerInsetEnd">28dp</item>
    </style>

    <style name="ShapeAppearance.App.DrawerItem" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TextAppearance.App.NavSubheader" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/font_inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="NavDrawerTextStyle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/font_inter_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Circle Image Style -->
    <style name="CircleImageStyle">
        <item name="android:background">@drawable/bg_avatar_ring</item>
        <item name="android:clipToOutline">true</item>
    </style>
    
    <!-- ============================================================ -->
<!-- STYLE DEFINITIONS YANG HILANG                                 -->
<!-- ============================================================ -->

<!-- Floating Action Button -->
<style name="Widget.App.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
    <item name="shapeAppearance">@style/ShapeAppearance.App.Corner.Medium</item>
</style>

<!-- Dialog Theme -->
<style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
    <item name="shapeAppearance">@style/ShapeAppearance.App.Dialog</item>
    <item name="android:fontFamily">@font/font_inter_regular</item>
    <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Outlined</item>
    <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Outlined</item>
</style>

<!-- Bottom Navigation -->
<style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
    <item name="itemActiveIndicatorStyle">@style/App.Custom.Indicator</item>
    <item name="labelVisibilityMode">labeled</item>
</style>

<!-- Active Indicator untuk BottomNav -->
<style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
    <item name="android:color">?attr/colorPrimaryContainer</item>
</style>

<!-- Text Input Layout -->
<style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxCornerRadiusTopStart">@dimen/radius_card_compact</item>
    <item name="boxCornerRadiusTopEnd">@dimen/radius_card_compact</item>
    <item name="boxCornerRadiusBottomStart">@dimen/radius_card_compact</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/radius_card_compact</item>
    <item name="boxStrokeColor">?attr/colorPrimary</item>
    <item name="android:fontFamily">@font/font_inter_regular</item>
</style>

<!-- Chip -->
<style name="Widget.App.Chip" parent="Widget.Material3.Chip.Assist">
    <item name="shapeAppearance">@style/ShapeAppearance.App.Chip</item>
    <item name="android:fontFamily">@font/font_inter_medium</item>
</style>

<style name="ShapeAppearance.App.Chip" parent="">
    <item name="cornerSize">@dimen/radius_chip</item>
</style>

<!-- Shape Appearance Dialog -->
<style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
    <item name="cornerSize">@dimen/radius_dialog</item>
</style>
</resources>