    <string name="conv_encrypt_first_title">Encrypt before converting (AES-256)</string>
    <string name="conv_encrypt_first_hint">Encrypts the .so first, then outputs protected_lib_data.h + protected_lib_key.h — ready to drop into your loader\'s jni/ folder. Format and array name are locked while this is on.</string>
