    <string name="conv_done_body_encrypt">Two files were created in MonToolKit/Converter:\n• protected_lib_data.h\n• protected_lib_key.h\n\nCopy both into your loader\'s jni/ folder, overwriting the placeholders. Then just build — no code changes needed on the loader side.</string>

    <string name="conv_encrypt_section_title">Encryption (.so only)</string>
    <string name="conv_encrypt_section_subtitle">Pick a mode below — only applies once you select a .so file.</string>
    <string name="conv_encrypt_mode_off">Off — normal convert</string>
    <string name="conv_encrypt_mode_then_convert">Encrypt, then convert to header (.h)</string>
    <string name="conv_encrypt_mode_only">Encrypt .so only (.enc, no header)</string>
    <string name="conv_encrypt_only_hint">Outputs a plain .enc file (AES-256-CTR) plus a keyinfo.txt with the Base64 key. No header/array conversion happens in this mode.</string>
