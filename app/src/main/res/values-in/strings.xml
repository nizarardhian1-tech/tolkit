    <!-- Opsi Encrypt Dulu (SoEncryptor, khusus file .so) -->
    <string name="conv_encrypt_first_title">Enkripsi dulu sebelum convert (AES-256)</string>
    <string name="conv_encrypt_first_hint">File .so dienkripsi dulu, lalu hasilnya berupa protected_lib_data.h + protected_lib_key.h — tinggal drop ke folder jni/ loader kamu. Format dan nama array otomatis dikunci selama opsi ini aktif.</string>
