<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvSplashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            android:fontFamily="@font/font_inter_bold"
            android:alpha="0" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_subtitle"
            android:textSize="14sp"
            android:fontFamily="@font/font_inter_regular"
            android:textColor="#FFFFFF"
            android:alpha="0" />

        <View
            android:id="@+id/viewSplashAccentBar"
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/shape_splash_accent_bar"
            android:alpha="0.9"
            android:scaleX="0" />

    </LinearLayout>

</FrameLayout>