<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_dialog"
    app:cardBackgroundColor="@color/glass_surface"
    app:cardElevation="@dimen/elevation_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#2575FC"
            app:trackColor="?attr/colorSurfaceVariant"
            app:indicatorSize="64dp"
            app:trackThickness="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/progress_title"
            android:textSize="18sp"
            android:fontFamily="@font/font_inter_semibold"
            android:textColor="?attr/colorOnSurface"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/progress_message"
            android:textAlignment="center"
            android:textSize="13sp"
            android:fontFamily="@font/font_inter_regular"
            android:textColor="?android:textColorSecondary"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>