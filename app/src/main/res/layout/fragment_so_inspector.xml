<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Card: pilih file -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFileSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke"
            app:cardElevation="@dimen/elevation_card"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_inspector"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inspector_tap_to_select"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inspector_supports_so"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"/>
                <ProgressBar
                    android:id="@+id/progressInspector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvInspectorProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    android:text="@string/inspector_parsing"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Error state -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="@drawable/bg_file_icon"
            android:textColor="@color/file_color_pdf"
            android:textSize="13sp"
            android:visibility="gone"/>

        <!-- Result container -->
        <LinearLayout
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Ringkasan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="0dp"
                app:cardElevation="@dimen/elevation_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvSoName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="libmain.so"/>

                    <TextView
                        android:id="@+id/tvArch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Architecture: AArch64 (arm64-v8a) · 64-bit"/>

                    <TextView
                        android:id="@+id/tvStripped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Debug symbols: Stripped"/>

                    <TextView
                        android:id="@+id/tvEntryPoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Entry point: 0x00012a40"/>

                    <TextView
                        android:id="@+id/tvBuildId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Build ID: c31d24ca53836cd2"/>

                    <TextView
                        android:id="@+id/tvFileSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="File size: 842 KB"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Security / Hardening Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/glass_surface_variant"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_security_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"/>

                    <TextView
                        android:id="@+id/tvSha256"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:ellipsize="middle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="SHA-256: 8f14e45fceea167a5a36dedd4bea2543..."/>

                    <TextView
                        android:id="@+id/tvHardening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="NX: Yes · RELRO: Full · Canary: Yes · Fortify: Yes"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Export & Extract Strings Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:baselineAligned="false">

                <RelativeLayout
                    android:id="@+id/btnExportSymbols"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_gradient_button"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_export_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/btnExtractStrings"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_gradient_button"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_strings_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/btnStripSymbols"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_gradient_button"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_strip_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- Needed libraries -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/inspector_needed_libs_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>
            <TextView
                android:id="@+id/tvNeededLibs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:lineSpacingExtra="4dp"
                tools:text="libc.so\nliblog.so\nlibm.so"/>

            <!-- Exported functions -->
            <TextView
                android:id="@+id/tvExportedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Exported Functions (12)"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExported"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false"
                android:scrollbars="vertical"/>

            <!-- Imported functions -->
            <TextView
                android:id="@+id/tvImportedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Imported Functions (34)"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvImported"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false"
                android:scrollbars="vertical"/>
        </LinearLayout>

        <!-- Bottom Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>