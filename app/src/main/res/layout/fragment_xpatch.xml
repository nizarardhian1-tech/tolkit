<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xpatch_title"
            android:textSize="24sp"
            android:fontFamily="@font/font_inter_bold"
            android:textColor="?attr/colorOnSurface"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xpatch_subtitle"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"/>

        <!-- ==================== SECTION 1: PEMILIH APLIKASI & MODUL ==================== -->
        <!-- Target App Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFileSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/layoutTargetIconContainer"
                    android:layout_width="56dp"
                    android:layout_height="48dp">
                    <ImageView
                        android:id="@+id/ivTargetIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_apk"
                        app:tint="?attr/colorPrimary"/>
                    <ImageView
                        android:id="@+id/ivTargetIcon1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:visibility="gone"
                        style="@style/CircleImageStyle"/>
                    <ImageView
                        android:id="@+id/ivTargetIcon2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="12dp"
                        android:visibility="gone"
                        style="@style/CircleImageStyle"/>
                    <ImageView
                        android:id="@+id/ivTargetIcon3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="24dp"
                        android:visibility="gone"
                        style="@style/CircleImageStyle"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_select_target"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_target_hint"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Module Select Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardModuleSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/layoutModuleIconContainer"
                    android:layout_width="56dp"
                    android:layout_height="48dp">
                    <ImageView
                        android:id="@+id/ivModuleIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_code_convert"
                        app:tint="?attr/colorPrimary"/>
                    <ImageView
                        android:id="@+id/ivModuleIcon1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:visibility="gone"
                        style="@style/CircleImageStyle"/>
                    <ImageView
                        android:id="@+id/ivModuleIcon2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="12dp"
                        android:visibility="gone"
                        style="@style/CircleImageStyle"/>
                    <ImageView
                        android:id="@+id/ivModuleIcon3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="24dp"
                        android:visibility="gone"
                        style="@style/CircleImageStyle"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvModuleName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_select_module"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:id="@+id/tvModeHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_module_hint"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SECTION 2: BYPASS SIGNATURE ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xpatch_bypass_level"
            android:textSize="14sp"
            android:fontFamily="@font/font_inter_semibold"
            android:layout_marginTop="24dp"
            android:textColor="?attr/colorPrimary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RadioGroup
                    android:id="@+id/rgBypassLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbBypassOff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_bypass_lv0"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <RadioButton
                        android:id="@+id/rbBypassPM"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_bypass_lv1"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <RadioButton
                        android:id="@+id/rbBypassLibc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_bypass_lv2"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:checked="true"/>
                    <RadioButton
                        android:id="@+id/rbBypassExtreme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_bypass_lv3"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <RadioButton
                        android:id="@+id/rbBypassSeccomp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xpatch_bypass_lv4"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"/>
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SECTION 3: ADVANCED & EXPERIMENTAL ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xpatch_advanced_features"
            android:textSize="14sp"
            android:fontFamily="@font/font_inter_semibold"
            android:layout_marginTop="24dp"
            android:textColor="?attr/colorPrimary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Version Override -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_version_override"
                    android:fontFamily="@font/font_inter_semibold"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOverrideCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ver. Code (cth: 99)"
                            android:textColor="?attr/colorOnSurface"
                            android:inputType="number"
                            android:textSize="13sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOverrideName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ver. Name (cth: 1.0.0)"
                            android:textColor="?attr/colorOnSurface"
                            android:inputType="text"
                            android:textSize="13sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/glass_stroke"
                    android:layout_marginVertical="12dp"/>

                <!-- Switches -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMicroG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_switch_microg"
                    android:textColor="?attr/colorOnSurface"
                    android:checked="false"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchInjectProvider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_switch_inject_provider"
                    android:textColor="?attr/colorOnSurface"
                    android:checked="false"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAntiDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_switch_antidebug"
                    android:textColor="?attr/colorOnSurface"
                    android:checked="false"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/glass_stroke"
                    android:layout_marginVertical="12dp"/>

                <!-- Experimental -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_experimental_title"
                    android:fontFamily="@font/font_inter_semibold"
                    android:textSize="13sp"
                    android:textColor="@color/colorError"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/xpatch_experimental_warning"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchHideDlIterate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_switch_hide_dl_iterate"
                    android:textColor="?attr/colorOnSurface"
                    android:checked="false"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchTrapPrctl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_switch_trap_prctl"
                    android:textColor="?attr/colorOnSurface"
                    android:checked="false"/>

                <TextView
                    android:id="@+id/tvTrapPrctlHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/xpatch_trap_prctl_hint"
                    android:textSize="11sp"
                    android:textColor="@color/colorError"
                    android:visibility="gone"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchNormalizeTiming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xpatch_switch_normalize_timing"
                    android:textColor="?attr/colorOnSurface"
                    android:checked="false"/>

                <TextView
                    android:id="@+id/tvNormalizeTimingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/xpatch_normalize_timing_hint"
                    android:textSize="11sp"
                    android:textColor="@color/colorError"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SECTION 4: DEVICE & GPU SPOOF ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_spoof_title"
            android:textSize="14sp"
            android:fontFamily="@font/font_inter_semibold"
            android:layout_marginTop="24dp"
            android:textColor="?attr/colorPrimary"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceSpoof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_inspector"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_spoof_subtitle"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_spoof_desc"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvDeviceSpoofLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_spoof_off"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_inter_semibold"
                    android:textColor="?attr/colorPrimary"
                    android:paddingEnd="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PROGRESS BAR -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceVariant"
                android:max="100"/>
            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/xpatch_modifying"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <!-- TOMBOL START PATCH -->
        <RelativeLayout
            android:id="@+id/btnPatch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_gradient_button"
            android:clickable="true"
            android:focusable="true"
            android:duplicateParentState="true">
            <TextView
                android:id="@+id/tvBtnPatchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xpatch_build_button"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/font_inter_bold"
                android:textSize="16sp"
                android:layout_centerInParent="true"/>
            <ProgressBar
                android:id="@+id/pbBtnPatchBusy"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/tvBtnPatchLabel"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone"/>
        </RelativeLayout>

        <!-- Bottom Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>