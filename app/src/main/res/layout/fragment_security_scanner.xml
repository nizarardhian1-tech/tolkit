<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/securityScannerScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security_scanner_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_security_scanner"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:textColor="?android:textColorSecondary"/>

        <!-- Pilih APK -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPickApk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/glass_surface_variant"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <ImageView
                    android:id="@+id/ivApkIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_apk"
                    app:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apk_signer_pick_apk"
                        android:textSize="13sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:id="@+id/tvApkName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_pick_apk_hint"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:textColor="?android:textColorSecondary"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Scan -->
        <RelativeLayout
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_gradient_button"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_scanner_btn_scan"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>

        <!-- Progress -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="#DC3545"
                app:trackColor="?attr/colorSurfaceVariant"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/security_scanner_scanning"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"/>
        </LinearLayout>

        <!-- ==================== HASIL SCAN (hidden sampai selesai scan) ==================== -->
        <LinearLayout
            android:id="@+id/containerResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Signing Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_signing"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvSigningInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textSize="11.5sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Manifest Security -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_manifest"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvManifest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textSize="11.5sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dangerous Permissions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_permissions"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secrets -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_secrets"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvSecrets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textSize="11.5sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- URLs & IPs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_network"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textSize="11.5sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weak Crypto -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_crypto"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvCrypto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detected SDKs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_sdks"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvSdks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Native Library Hardening -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/glass_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security_scanner_section_native"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_inter_semibold"
                        android:textColor="?attr/colorPrimary"/>
                    <TextView
                        android:id="@+id/tvNativeLibs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/security_scanner_disclaimer"
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="?android:textColorSecondary"/>

            <!-- Tombol Export -->
            <RelativeLayout
                android:id="@+id/btnExport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_patch_console_outline_button"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/security_scanner_btn_export"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvExportResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
