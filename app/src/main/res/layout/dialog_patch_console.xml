<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- ===== PEEK SECTION: yang tetap kelihatan saat sheet di-collapse ===== -->
    <LinearLayout
        android:id="@+id/peekSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_patch_drag_handle" />

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_patch_status_chip">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_console"
                    app:tint="@color/console_accent_cyan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvConsoleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/patch_console_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/tvConsoleSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/patch_console_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConsoleStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_patch_status_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/patch_console_status_running"
                android:textColor="@color/console_accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/btnConsoleToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@string/patch_console_chevron_collapse"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- PROGRESS -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/consoleProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:indicatorColor="@color/console_accent_cyan"
            app:trackColor="?attr/colorSurfaceVariant"
            app:trackThickness="3dp"
            app:trackCornerRadius="4dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvConsoleProgressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- ===== EXPANDED SECTION: cuma kelihatan penuh saat sheet di-expand ===== -->
    <LinearLayout
        android:id="@+id/expandedSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- CONSOLE / TERMINAL BODY — sengaja tetap gelap pekat kayak terminal asli,
             biar kerasa 'engine'-nya, walau chrome di sekitarnya ikut tema app -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_patch_console"
            android:padding="14dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/consoleScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tvConsoleLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/console_text_primary"
                    android:textIsSelectable="true" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- FOOTER ACTIONS — dua tombol dibikin dengan struktur PERSIS SAMA
             (FrameLayout 52dp + TextView gravity center) supaya teksnya sejajar sempurna -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnConsoleBack"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_patch_console_outline_button"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/patch_console_return"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnConsoleInstall"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gradient_button"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvConsoleInstallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/patch_console_install"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
