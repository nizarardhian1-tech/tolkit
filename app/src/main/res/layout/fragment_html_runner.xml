<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/html_runner_title"
                android:textSize="21sp"
                android:fontFamily="@font/font_inter_semibold"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_html_runner"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRecentFiles"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_pill"
            android:src="@drawable/ic_recent_files"
            android:padding="10dp"
            app:tint="?attr/colorOnSurface"/>

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_pill"
            android:src="@drawable/ic_history"
            android:padding="10dp"
            app:tint="?attr/colorOnSurface"/>

        <ImageButton
            android:id="@+id/btnSaveExport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_pill"
            android:src="@drawable/ic_save"
            android:padding="10dp"
            app:tint="?attr/colorOnSurface"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFile"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingHorizontal="4dp"
            android:gravity="center"
            app:icon="@drawable/ic_open_file"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="6dp"
            android:text="@string/action_open_file_short"
            android:textSize="12.5sp"
            android:textAllCaps="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFolder"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingHorizontal="4dp"
            android:gravity="center"
            app:icon="@drawable/ic_open_folder"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="6dp"
            android:text="@string/action_open_folder_short"
            android:textSize="12.5sp"
            android:textAllCaps="false"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1.15"
            android:layout_height="48dp"
            android:layout_marginStart="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_run_gradient"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRun"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                app:icon="@drawable/ic_run"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="18dp"
                android:elevation="0dp"
                android:text="RUN"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"/>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabCode"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            app:icon="@drawable/ic_tab_code"
            app:iconGravity="textStart"
            android:text="@string/tab_code"
            android:textSize="12.5sp"
            android:textAllCaps="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPreview"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            app:icon="@drawable/ic_tab_preview"
            app:iconGravity="textStart"
            android:text="@string/tab_preview"
            android:textSize="12.5sp"
            android:textAllCaps="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabConsole"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            app:icon="@drawable/ic_tab_console"
            app:iconGravity="textStart"
            android:text="@string/tab_console"
            android:textSize="12.5sp"
            android:textAllCaps="false"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/glass_surface_container"
            app:cardCornerRadius="24dp"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke">

            <!-- CODE EDITOR NATIVE -->
            <LinearLayout
                android:id="@+id/codeEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="16dp"
                    android:gravity="top|end"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:scrollbars="none"
                    android:text="1"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/glass_stroke"/>

                <com.mondns.app.SyncScrollEditText
                    android:id="@+id/etCode"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:hint="&lt;!-- Paste here --&gt;"
                    android:scrollbars="vertical"/>
            </LinearLayout>

            <!-- PREVIEW -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

            <!-- CONSOLE -->
            <LinearLayout
                android:id="@+id/consoleContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/glass_surface_variant"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/console_output_label"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <TextView
                        android:id="@+id/btnCopyConsole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/console_copy"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11.5sp"
                        android:padding="4dp"
                        android:layout_marginEnd="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <TextView
                        android:id="@+id/btnClearConsole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/console_clear"
                        android:textColor="@color/console_text_error"
                        android:textSize="11.5sp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scrollConsole"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvConsole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/console_initial_text"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="true"/>
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>